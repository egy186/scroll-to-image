{
  "name": "scroll-to-image",
  "version": "0.8.5",
  "private": true,
  "description": "Scroll to the next image.",
  "homepage": "https://github.com/egy186/scroll-to-image#readme",
  "bugs": {
    "url": "https://github.com/egy186/scroll-to-image/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egy186/scroll-to-image.git"
  },
  "license": "MIT",
  "author": "egy186",
  "type": "module",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist web-ext-artifacts",
    "lint": "npm run lint:eslint && npm run lint:typecheck && npm run lint:manifest",
    "lint:eslint": "eslint",
    "prelint:manifest": "npm run build",
    "lint:manifest": "web-ext lint --self-hosted",
    "lint:typecheck": "tsc",
    "prerelease": "npm run build",
    "release": "web-ext sign --channel unlisted --api-key $API_KEY --api-secret $API_SECRET",
    "prestart": "npm run build",
    "start": "web-ext run --devtools",
    "version": "jiti lib/version.ts && git add docs/updates.json"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@egy186/eslint-config": "^4.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.2.0",
    "@mui/x-data-grid": "^9.12.0",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "valibot": "^1.4.2",
    "vite": "^8.2.1",
    "web-ext": "^10.6.0"
  }
}
